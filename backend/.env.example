# Existing database and JWT settings remain in .env
GOOGLE_CLIENT_ID=
RVCE_EMAIL_DOMAIN=your-rvce-email-domain
# Comma-separated initial SPC accounts. Use exact addresses, not whole domains.
SPC_EMAILS=spc1@your-rvce-email-domain,spc2@your-rvce-email-domain,spc3@your-rvce-email-domain
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173

# Email automation settings. Gmail notifications are stored in Postgres and
# processed by a lightweight background task inside the API service.
# Use a Google OAuth web application client, with this exact local callback URI
# registered under Authorized redirect URIs and your deployed callback added too.
GOOGLE_OAUTH_CLIENT_ID=your-gmail-oauth-web-client-id
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/gmail/callback
# Set this to a 32-byte Fernet key before storing OAuth credentials.
GOOGLE_PUBSUB_TOPIC=projects/your-project-id/topics/driveboard-gmail-events
GOOGLE_PUBSUB_SUBSCRIPTION=projects/your-project-id/subscriptions/driveboard-gmail-events-sub
GOOGLE_PUBSUB_AUDIENCE=https://your-api-host/api/webhooks/gmail
GOOGLE_PUBSUB_SERVICE_ACCOUNT=driveboard-pubsub-push@your-project.iam.gserviceaccount.com
SPCS_GMAIL_ADDRESS=maaryamannp.mca25@rvce.edu.in
PLACEMENT_SENDER_DOMAIN=rvce.edu.in
TOKEN_ENCRYPTION_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=120
# Keep the inference key server-side. Groq is the hosted Render option; Ollama is local.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# FastAPI Mail / SMTP
BREVO_API_KEY=
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_FROM=notifications@example.com
MAIL_FROM_NAME=Driveboard
